# Request: a stable SPHERE primitive estimate + its supporting point cloud,
# as produced by /perception/get_stable_estimate and forwarded by the grasp
# planning dispatcher. Mirrors GetCylinderGraspPose.srv's request shape.
pcl_package/PrimitiveEstimate estimate
sensor_msgs/PointCloud2 cloud
---
bool success
string reason                    # populated only if success == false

geometry_msgs/Pose grasp_pose_palm
geometry_msgs/Pose grasp_pose_flange
geometry_msgs/Pose approach_pose_palm
geometry_msgs/Pose approach_pose_flange

int32 sector_point_count
float32 sector_residual          # only meaningful if met_confidence_threshold is true
bool met_confidence_threshold    # false => sector_point_count fell below the service's
                                  #          minimum and this is the most-evidence fallback,
                                  #          not a residual-ranked pick
